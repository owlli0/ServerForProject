<?xml version="1.0" encoding="UTF-8" ?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="2026-05-07--0003-ParentChild" author="ssavelev">

        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="parent_child"/>
            </not>
        </preConditions>

        <createTable tableName="parent_child">
            <column name="id_note_pc" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="id_parent" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_pc_parent" referencedTableName="Parent" referencedColumnNames="id_parent"/>
            </column>
            <column name="id_child" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_pc_child" referencedTableName="Child" referencedColumnNames="id_child"/>
            </column>
        </createTable>
    </changeSet>
</databaseChangeLog>